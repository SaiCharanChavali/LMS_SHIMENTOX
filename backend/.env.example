# Copy this file to backend/.env and fill in the values. backend/.env is private and never committed.
# Restart the server after changing it.

# Public address of the LMS (used for Keka sign-in and certificate links), e.g. https://lms.yourcompany.com
LMS_PUBLIC_BASE_URL=

# ---------------------------------------------------------------- AI (Claude API)
# Turns on the AI learning assistant and "Create from a link with AI" in Manage Courses.
# Also needs the SDK on the server: pip install anthropic
# Using these features is billed by Anthropic; see docs/ai-assistant.md.
LMS_AI_ENABLED=0
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Keka
# Your Keka web address is https://<KEKA_COMPANY>.keka.com
KEKA_COMPANY=
# keka for the live account, kekademo for Keka's sandbox
KEKA_ENVIRONMENT=keka

# "Sign in with Keka account": SSO client details from Keka Support ("Keka as Identity Provider").
# Register this redirect URI with Keka: <LMS_PUBLIC_BASE_URL>/api/auth/keka/callback
KEKA_SSO_CLIENT_ID=
KEKA_SSO_CLIENT_SECRET=
# Only if Keka asks for a different callback address than the default above.
KEKA_SSO_REDIRECT_URI=

# Keka HRIS API credentials (Keka admin > Integrations & Automation > API access).
# Used to copy each employee's Keka details (name, job title, employee number, manager, status) into the LMS.
KEKA_API_CLIENT_ID=
KEKA_API_CLIENT_SECRET=
KEKA_API_KEY=
